{
  "manifest_version": 3,
  "name": "UI Consistency Checker",
  "version": "1.3",
  "description": "UI/UX analysis tool with comprehensive quality metrics, custom grid, and component consistency checking",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "clipboardWrite",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "UI Consistency Checker"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content.css",
        "content.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}